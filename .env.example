# 服务端口
PORT=8008

# 必填 MQTT 连接配置。MQTT_URL 必须使用 mqtts://。
MQTT_URL=
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC=
MQTT_QOS=0
MQTT_RETAIN=false

# 必填展厅鉴权。格式：token:exhibitionId[,token:exhibitionId...]
# Token：16-512 位高强度随机 secret，禁止提交真实值。
# exhibitionId：1-64 位 [A-Za-z0-9_-]，只用于路由。
# 同一个 exhibitionId 可配置多个 Token 以支持凭据轮换。
HC_TOKEN_MAP=example-token-a-0123456789abcdef:HC-A7K9P2,example-token-b-0123456789abcdef:HC-B4M8Q1

# 每个展厅的可信回程配置（用于校验 RUISI 传入的 context.callback）：
#   HC_HALL_<展厅ID大写、非字母数字转下划线>_AGENT             必填
#   HC_HALL_<展厅>_CALLBACK_ALLOWLIST                           可选，逗号分隔的 http(s) 白名单
#   HC_HALL_<展厅>_INGRESS_HOST / _INGRESS_PORT                 可选，可信回程入口
#   HC_HALL_<展厅>_INGRESS_TOKEN                                可选，同一全局 Ingress 目标时回退 INGRESS_TOKEN
#   HC_HALL_<展厅>_TO                                           可选，仅在请求缺少 reply_to 时兜底
#
# 回程目标始终使用 RUISI 传入的 context.callback 原值（协议/主机/端口/路径都不改写）。
# 上述配置只用于校验 callback 是否属于该展厅；配置了但 callback 不匹配时返回 403。
# 完全没有可信回程配置时回程被安全拒绝（403），不会使用未验证的 callback。
# 回程配置不完整不会阻断启动，普通 IOC 指令始终正常发布到 MQTT。
# 不同展厅的 AGENT 与回程入口重复只告警，不阻断启动。
HC_HALL_HC_A7K9P2_AGENT=
# 旧版已验收写法（推荐保留）：https 也可；默认路径需完全一致，条目以 / 结尾才按目录前缀放行
# HC_HALL_HC_A7K9P2_CALLBACK_ALLOWLIST=https://ruisi-a.example:8443/agent/send
HC_HALL_HC_A7K9P2_INGRESS_HOST=
HC_HALL_HC_A7K9P2_INGRESS_PORT=
HC_HALL_HC_A7K9P2_INGRESS_TOKEN=
# HC_HALL_HC_A7K9P2_TO=

HC_HALL_HC_B4M8Q1_AGENT=
# HC_HALL_HC_B4M8Q1_CALLBACK_ALLOWLIST=https://ruisi-b.example:8443/agent/send
HC_HALL_HC_B4M8Q1_INGRESS_HOST=
HC_HALL_HC_B4M8Q1_INGRESS_PORT=
HC_HALL_HC_B4M8Q1_INGRESS_TOKEN=
# HC_HALL_HC_B4M8Q1_TO=

# 第三个及更多展厅按同样规则追加，数量不写死。
# HC_HALL_HC_C6N3R5_AGENT=
# HC_HALL_HC_C6N3R5_INGRESS_HOST=
# HC_HALL_HC_C6N3R5_INGRESS_PORT=
# HC_HALL_HC_C6N3R5_INGRESS_TOKEN=
# HC_HALL_HC_C6N3R5_TO=

# 旧版兼容回退：展厅缺少 HC_HALL_* 时，回程校验使用以下全局 Ingress。
# IOC 的 AGENT 仅在 HC_TOKEN_MAP 只映射一个展厅时取全局 AGENT，
# 多展厅时沿用请求 context.agent，避免把 A 展厅身份套用到 B。
# INGRESS_TOKEN 仅在该展厅与全局 Ingress 为同一目标（或只映射一个展厅）时回退，
# 多展厅不同入口之间不复用全局 Token，避免跨展厅凭据串用。
# AGENT=
# INGRESS_HOST=
# INGRESS_PORT=
# INGRESS_TOKEN=

# 可选：RUISI 回程请求超时，默认 5000ms。
RUISI_CALLBACK_TIMEOUT_MS=5000

# 可选：Narration 时长倍率，默认 1。
HC_NARRATION_DURATION_SCALE=1

# 以下仅用于本地 mock RUISI Ingress（scripts/mock-ruisi-ingress.js）。
# 正式多展厅回程不再读取这三个全局变量，而使用各展厅 HC_HALL_* 配置。
INGRESS_HOST=127.0.0.1
INGRESS_PORT=29876
# INGRESS_TOKEN=
