PORT=8008

# Required MQTT connection settings. MQTT_URL must use mqtts://.
MQTT_URL=
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC=
MQTT_QOS=0
MQTT_RETAIN=false

# Required exhibition auth. Format: token:exhibitionId[,token:exhibitionId...]
# Token: 16-512 chars, high-strength random secret, never commit real values.
# exhibitionId: 1-64 chars [A-Za-z0-9_-], only used for routing.
# Multiple tokens may map to the same exhibitionId for credential rotation.
HC_TOKEN_MAP=example-token-a-0123456789abcdef:exhibition-a,example-token-b-0123456789abcdef:exhibition-b

# Required per-exhibition RUISI callback binding.
# Agent: authoritative return-path agent for this exhibition (request context.agent is ignored).
# CALLBACK_ALLOWLIST: comma-separated absolute http(s) URLs (matched by scheme + host + port + path prefix).
# INGRESS_TOKEN: optional per-exhibition outbound credential; defaults to INGRESS_TOKEN.
# The return-path port is pinned inside CALLBACK_ALLOWLIST; this executor has no
# HC_HALL_<id>_INGRESS_PORT variable because context.callback already carries host+port.
# Every exhibitionId in HC_TOKEN_MAP must have a complete block, otherwise startup fails.
HC_HALL_EXHIBITION_A_AGENT=
HC_HALL_EXHIBITION_A_CALLBACK_ALLOWLIST=
HC_HALL_EXHIBITION_A_INGRESS_TOKEN=
HC_HALL_EXHIBITION_B_AGENT=
HC_HALL_EXHIBITION_B_CALLBACK_ALLOWLIST=
HC_HALL_EXHIBITION_B_INGRESS_TOKEN=
# Third exhibition (for example HC-C6N3R5) follows the same rule.
HC_HALL_EXHIBITION_C_AGENT=
HC_HALL_EXHIBITION_C_CALLBACK_ALLOWLIST=
HC_HALL_EXHIBITION_C_INGRESS_TOKEN=

# Optional RUISI callback authentication and timeout.
INGRESS_TOKEN=
RUISI_CALLBACK_TIMEOUT_MS=5000

# Local mock RUISI ingress only.
INGRESS_HOST=127.0.0.1
INGRESS_PORT=29876

# Production recommendation. This only scales Narration durationMs.
HC_NARRATION_DURATION_SCALE=1
