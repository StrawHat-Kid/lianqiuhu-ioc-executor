PORT=8008

# Required MQTT connection settings. MQTT_URL must use mqtts://.
MQTT_URL=
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC=
MQTT_QOS=0
MQTT_RETAIN=false

# Required exhibition auth. Format: token:exhibitionId[,token:exhibitionId...]
# Token: 16-512 chars, high-strength random secret, never commit real values.
# exhibitionId: 1-64 chars [A-Za-z0-9_-], only used for routing.
# Multiple tokens may map to the same exhibitionId for credential rotation.
HC_TOKEN_MAP=example-token-a-0123456789abcdef:exhibition-a,example-token-b-0123456789abcdef:exhibition-b

# Optional RUISI callback authentication and timeout.
INGRESS_TOKEN=
RUISI_CALLBACK_TIMEOUT_MS=5000

# Local mock RUISI ingress only.
INGRESS_HOST=127.0.0.1
INGRESS_PORT=29876

# Production recommendation. This only scales Narration durationMs.
HC_NARRATION_DURATION_SCALE=1
