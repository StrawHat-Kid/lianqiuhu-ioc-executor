    {
      "name": "03 伪造展厅（需 MQTTX 复核）",
      "item": [
        {
          "name": "A Token + 伪造 B exhibitionId",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-HC-Token",
                "value": "{{tokenA}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"exhibitionId\": \"{{exhibitionIdB}}\",\n  \"commands\": [\n    { \"action\": \"主题切换\", \"params\": { \"主题名称\": \"综合安防\" } }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/commands",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "commands"
              ]
            },
            "description": "入站接口只支持数组或 {context, commands} 信封；顶层 exhibitionId 不是受支持字段，会被执行器忽略并记录告警。服务端必须按 A Token 映射为 HC-A7K9P2。Postman 无法验证 MQTT 内容，必须用 MQTTX 确认信封 exhibitionId 为 HC-A7K9P2，不得出现 HC-B4M8Q1。"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('ok=true', () => pm.expect(json.ok).to.eql(true));",
                  "pm.test('服务端映射应为 A：请用 MQTTX 核对信封 exhibitionId=HC-A7K9P2', () => { pm.expect(json.ok).to.eql(true); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "04 健康检查",
      "item": [
        {
          "name": "健康检查（无需 Token）",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "探活接口不需要 Token。mqttConnected=true 且 status=ready 表示 MQTT 已连接；mqtt_unavailable 表示 MQTT 未连接。"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('ok=true', () => pm.expect(json.ok).to.eql(true));",
                  "pm.test('status is ready or mqtt_unavailable', () => pm.expect(['ready', 'mqtt_unavailable']).to.include(json.status));",
                  "pm.test('mqttConnected is boolean', () => pm.expect(typeof json.mqttConnected).to.eql('boolean'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "05 Narration（需 MQTTX 观察异步信封）",
      "item": [
        {
          "name": "Narration A - 讲解园区基础信息",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-HC-Token",
                "value": "{{tokenA}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"context\": {\n    \"agent\": \"hc-local-agent-a\",\n    \"reply_to\": \"hc-local-user-a@example.com\",\n    \"groupchat\": false,\n    \"callback\": \"{{iocCallbackA}}\"\n  },\n  \"commands\": [\n    { \"action\": \"讲解园区基础信息\", \"params\": { \"language\": \"zh-CN\" } }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/commands",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "commands"
              ]
            },
            "description": "Narration 必须使用 {context, commands} 信封且 context 至少包含 agent、reply_to、callback。预期 HTTP 202 并返回 sessionId。后台会话会持续数十秒并向 MQTT 发布多条信封（prepare/start/终态清理），必须用 MQTTX 观察 exhibitionId=HC-A7K9P2。callback 必须与 A 展厅 HC_HALL_*_INGRESS_HOST/INGRESS_PORT 完全一致，本地占位地址不可达不会阻断会话。"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 202', () => pm.response.to.have.status(202));",
                  "const json = pm.response.json();",
                  "pm.test('ok=true', () => pm.expect(json.ok).to.eql(true));",
                  "pm.test('message=narration accepted', () => pm.expect(json.message).to.eql('narration accepted'));",
                  "pm.test('sessionId present', () => pm.expect(json.sessionId).to.be.a('string').and.not.empty);"
                ]
              }
            }
          ]
        },
        {
          "name": "Narration B - 讲解园区基础信息",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-HC-Token",
                "value": "{{tokenB}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"context\": {\n    \"agent\": \"hc-local-agent-b\",\n    \"reply_to\": \"hc-local-user-b@example.com\",\n    \"groupchat\": false,\n    \"callback\": \"{{iocCallbackB}}\"\n  },\n  \"commands\": [\n    { \"action\": \"讲解园区基础信息\", \"params\": { \"language\": \"zh-CN\" } }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/commands",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "commands"
              ]
            },
            "description": "Narration B 使用 B 展厅 Token 与 B 展厅 callback。预期 HTTP 202，MQTTX 只看到 exhibitionId=HC-B4M8Q1；A 展厅会话不受影响。"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 202', () => pm.response.to.have.status(202));",
                  "const json = pm.response.json();",
                  "pm.test('ok=true', () => pm.expect(json.ok).to.eql(true));",
                  "pm.test('message=narration accepted', () => pm.expect(json.message).to.eql('narration accepted'));",
                  "pm.test('sessionId present', () => pm.expect(json.sessionId).to.be.a('string').and.not.empty);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "06 回程隔离（预期 403）",
      "item": [
        {
          "name": "A Token + B callback（预期 403）",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-HC-Token",
                "value": "{{tokenA}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"context\": {\n    \"agent\": \"spoofed-agent\",\n    \"reply_to\": \"user@example.com\",\n    \"groupchat\": false,\n    \"callback\": \"{{iocCallbackB}}\"\n  },\n  \"commands\": [\n    { \"action\": \"讲解园区基础信息\", \"params\": { \"language\": \"zh-CN\" } }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/commands",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "commands"
              ]
            },
            "description": "使用 A 展厅 Token，但 context.callback 指向 B 展厅。执行器应按 A 展厅可信 Ingress 校验并返回 403，不发布 MQTT、不回程。"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 403', () => pm.response.to.have.status(403));",
                  "const json = pm.response.json();",
                  "pm.test('error is callback target rejected', () => pm.expect(json.error).to.eql('callback target is not allowed for this exhibition'));"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
