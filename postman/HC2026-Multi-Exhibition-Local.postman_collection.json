{
  "info": {
    "_postman_id": "6f2a1c9e-8d4b-4f7a-9c31-8e2d5a7b9f01",
    "name": "HC2026 Multi-Exhibition Local",
    "description": "练秋湖 HC2026 多展厅统一执行器本地联调集合。\n\n前置条件：\n1. 导入配套 Environment：HC2026-Multi-Exhibition-Local.postman_environment.json。\n2. 执行器已按 .env 配置 HC_TOKEN_MAP（本地测试映射 A/B/C）并已启动（本集合不会自动启动服务）。\n3. MQTT 信封内容无法由 Postman 验证，必须按 README 使用 MQTTX 观察。\n\n安全说明：集合中的 Token 全部来自环境变量，均为本地测试值，禁止用于正式环境。",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 有效 Token 普通命令",
      "item": [
        {
          "name": "A - 有效 Token 普通命令",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-HC-Token",
                "value": "{{tokenA}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "[\n  { \"action\": \"主题切换\", \"params\": { \"主题名称\": \"综合安防\" } }\n]",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/commands",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "commands"
              ]
            },
            "description": "使用 A 展厅 Token 发送普通 IOC 指令。预期 HTTP 200，MQTTX 应看到 exhibitionId 为 HC-A7K9P2 的信封。"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('ok=true', () => pm.expect(json.ok).to.eql(true));",
                  "pm.test('message=commands published', () => pm.expect(json.message).to.eql('commands published'));"
                ]
              }
            }
          ]
        },
